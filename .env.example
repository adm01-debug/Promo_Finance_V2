# ============================================================
# .env.example  —  promo-finance-v2
# Copie este arquivo para .env e preencha com valores reais.
# Variáveis VITE_* vão pro bundle frontend (visíveis ao usuário final).
# Variáveis sem VITE_ são para backend / edge functions / scripts.
#
# ⚠️ PRODUÇÃO: secrets NÃO ficam neste arquivo — vivem no vault do
# Lovable Cloud (Backend → Secrets). Este .env é APENAS para dev local.
# Ver docs/RUNBOOK.md §6 para cadência de rotação de cada secret.
# ============================================================


# --- Supabase (frontend) ---
# Pegue em: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PROJECT_ID=seu-projeto
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# --- Bitrix24 (frontend) ---
VITE_BITRIX=https://seudominio.bitrix24.com.br/rest/1/SEU_CODIGO/

# --- Bling ERP (frontend) ---
VITE_BLING_CLIENT_ID=seu_bling_client_id

# --- Ambiente / API (frontend) ---
VITE_ENVIRONMENT=development
VITE_API_URL=http://localhost:54321
VITE_DEBUG=true

# --- Sentry (frontend, opcional) ---
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# ============================================================
#  BACKEND (edge functions, scripts node — não vão pro bundle)
# ============================================================

# --- Bitrix24 backend ---
BITRIX24_WEBHOOK=https://seudominio.bitrix24.com.br/rest/1/SEU_CODIGO/

# --- SEFAZ (NFe) ---
SEFAZ_AMBIENTE=homologacao
SEFAZ_CERTIFICADO_PATH=./certificado.pfx
SEFAZ_CERTIFICADO_PASSWORD=

# --- Open Finance ---
OPEN_FINANCE_CLIENT_ID=
OPEN_FINANCE_CLIENT_SECRET=
OPEN_FINANCE_REDIRECT_URI=https://seudominio.com/callback

# --- Email (Resend em produção via vault) ---
# RESEND_API_KEY é gerenciado no vault; SMTP abaixo é fallback dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- WhatsApp (Evolution API) ---
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER=

# ============================================================
# SECRETS GERENCIADOS NO VAULT (não preencher aqui em produção)
# ============================================================
# LOVABLE_API_KEY                — AI Gateway (managed)
# MAPBOX_ACCESS_TOKEN            — Mapas / heatmap
# RESEND_API_KEY                 — Envio de email
# EXTERNAL_SUPABASE_URL          — Proxy CRM externo
# EXTERNAL_SUPABASE_SERVICE_ROLE_KEY
# ASAAS_WEBHOOK_TOKEN            — HMAC webhook Asaas
# BLING_WEBHOOK_SECRET           — HMAC webhook Bling
# BITRIX24_WEBHOOK_TOKEN         — HMAC webhook Bitrix24

