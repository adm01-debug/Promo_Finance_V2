# ============================================================
# .env.example  —  lalamove-v2-27
# Copie este arquivo para .env e preencha com valores reais.
# Variáveis VITE_* vão pro bundle frontend (visíveis ao usuário final).
# Variáveis sem VITE_ são para backend / edge functions / scripts.
# ============================================================

# --- Supabase (frontend) ---
# Pegue em: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PROJECT_ID=seu-projeto
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# --- Bitrix24 (frontend) ---
VITE_BITRIX=https://seudominio.bitrix24.com.br/rest/1/SEU_CODIGO/

# --- Bling ERP (frontend) ---
VITE_BLING_CLIENT_ID=seu_bling_client_id

# --- Ambiente / API (frontend) ---
VITE_ENVIRONMENT=development
VITE_API_URL=http://localhost:54321
VITE_DEBUG=true

# --- Sentry (frontend, opcional) ---
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# ============================================================
#  BACKEND (edge functions, scripts node — não vão pro bundle)
# ============================================================

# --- Bitrix24 backend ---
BITRIX24_WEBHOOK=https://seudominio.bitrix24.com.br/rest/1/SEU_CODIGO/

# --- SEFAZ (NFe) ---
SEFAZ_AMBIENTE=homologacao
SEFAZ_CERTIFICADO_PATH=./certificado.pfx
SEFAZ_CERTIFICADO_PASSWORD=

# --- Open Finance ---
OPEN_FINANCE_CLIENT_ID=
OPEN_FINANCE_CLIENT_SECRET=
OPEN_FINANCE_REDIRECT_URI=https://seudominio.com/callback

# --- Email ---
SENDGRID_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- WhatsApp ---
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER=
