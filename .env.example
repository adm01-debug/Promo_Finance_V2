# =============================================================================
# .env.example — promo-finance-v2
# Copie para .env e preencha com valores reais.
#
# LEITURA DESTA LISTA: src/config/env.ts é a fonte única de verdade.
# Todas as VITE_* abaixo são validadas com Zod na carga do app.
# Variáveis sem VITE_ são EXCLUSIVAS de edge functions / CI — não entram no bundle.
#
# ⚠️  PRODUÇÃO: secrets NÃO ficam neste arquivo.
#     Vivem no vault do Supabase (dashboard > Settings > Vault)
#     ou como GitHub Actions secrets (.github/workflows/README.md §2).
# =============================================================================


# === FRONTEND (bundle — injetadas pelo Vite) ===================================

# Supabase — OBRIGATÓRIAS (assertSupabaseEnv no vite.config + Zod em env.ts)
VITE_SUPABASE_URL=https://bwwbeyolnnzppeuhgkcd.supabase.co
VITE_SUPABASE_PROJECT_ID=bwwbeyolnnzppeuhgkcd
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bling OAuth — opcional; degradação graciosa (useOAuth.ts usa fallback '')
VITE_BLING_CLIENT_ID=

# Web Push VAPID — opcional; push desabilitado se ausente
# A chave PÚBLICA vai aqui. A PRIVADA NUNCA vai aqui — vive no vault do Supabase.
# Par gerado em 2026-09-05 e armazenado como VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY no vault.
VITE_VAPID_PUBLIC_KEY=


# === EDGE FUNCTIONS (vault do Supabase, NÃO aqui em produção) =================
# Para dev local com supabase start, defina em supabase/functions/.env

# Infraestrutura interna
SUPABASE_URL=https://bwwbeyolnnzppeuhgkcd.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bitrix24
BITRIX24_DOMAIN=seudominio.bitrix24.com.br
BITRIX24_ACCESS_TOKEN=
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=

# Notificações e email
RESEND_API_KEY=
RESEND_FROM=noreply@promobrindes.com.br
SLACK_WEBHOOK_URL=

# Integrações financeiras
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# NF-e / SEFAZ
SEFAZ_CRON_SECRET=
NFE_CERT_MASTER_KEY=

# Open Finance
OPEN_FINANCE_BASE_URL=https://api.openfinance.com.br
OPEN_FINANCE_CLIENT_ID=
OPEN_FINANCE_CLIENT_SECRET=
OPEN_FINANCE_REDIRECT_URI=https://bwwbeyolnnzppeuhgkcd.supabase.co/functions/v1/open-finance-callback

# CRM / dados externos
CNPJA_API_KEY=
MAPBOX_ACCESS_TOKEN=
OPENAI_API_KEY=

# CRON dispatch (compartilhado com workflows N8N)
CRON_DISPATCH_SECRET=
N8N_DISPATCH_SECRET=

# Comparação de schema (staging)
SCHEMA_COMPARE_EXTERNAL_URL=
SCHEMA_COMPARE_EXTERNAL_SERVICE_ROLE_KEY=

# Web Push (privada — nunca no bundle)
VAPID_PRIVATE_KEY=

# CI/security gate (par com GitHub Actions secret CI_GATE_LOG_SECRET)
CI_GATE_LOG_SECRET=
