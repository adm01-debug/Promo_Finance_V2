# Base44 dev placeholders. These let the app boot and render before real
# credentials are supplied. Real values are delivered via /run/base44/app.env
# (platform-managed) and override these because that file is listed LAST in
# the compose env_file chain.

# --- Supabase (frontend) ---
VITE_SUPABASE_URL=https://placeholder-project.supabase.co
VITE_SUPABASE_PROJECT_ID=placeholder-project
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder_xxxxxxxxxxxxxxxxxxxxx

# --- Bling ERP (frontend) ---
VITE_BLING_CLIENT_ID=placeholder_bling_client_id

# --- Web Push (frontend) ---
VITE_VAPID_PUBLIC_KEY=

# --- Ambiente / API (frontend) ---
VITE_ENVIRONMENT=development
VITE_API_URL=http://localhost:54321
VITE_DEBUG=true

# --- Sentry (frontend, opcional) ---
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
